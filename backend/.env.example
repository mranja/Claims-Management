# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (Atlas or Local)
# If left empty or invalid, system automatically falls back to in-memory MongoDB server
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/claims_management?retryWrites=true&w=majority

# AI API Key (Gemini / Claude / ClaimIQ)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_ai_api_key_here
